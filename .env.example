# Copy this file to .env and adjust values if you need to.
# These public NLM APIs do not require an API key.

# How long to wait for each terminology API call, in seconds.
TERMINOLOGY_API_TIMEOUT_SECONDS=10

# Official NLM Clinical Tables ICD-10-CM search endpoint.
ICD10_API_BASE_URL=https://clinicaltables.nlm.nih.gov/api/icd10cm/v3/search

# Official NLM RxNorm REST base URL.
RXNORM_API_BASE_URL=https://rxnav.nlm.nih.gov/REST
